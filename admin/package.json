{
  "name": "epc-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute epc-admin-db --local --file=./migrations/schema.sql",
    "db:migrate:remote": "wrangler d1 execute epc-admin-db --remote --file=./migrations/schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
